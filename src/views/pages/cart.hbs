<div class="container">
  <h1>Mi Carrito</h1>

  <div class="cart-list" data-cart-id="{{cart._id}}">
    {{#each cart.products}}
      <div class="cart-item" data-pid="{{this.product._id}}">
        <span>{{this.product.title}}</span>
        <span class="quantity">{{this.quantity}}</span>

        <button class="increase-btn">+</button>
        <button class="decrease-btn">-</button>
      </div>
    {{/each}}
  </div>

  <button id="clear-cart-btn">Vaciar Carrito</button>
  <button id="purchase-btn">Confirmar Compra</button>

  <div id="purchase-overlay" class="overlay">
    <div class="modal">
      <h3>Ticket de Compra</h3>
      <div id="ticket-info"></div>
      <button id="close-overlay">Cerrar</button>
    </div>
  </div>

  <div id="cart-message" style="display:none;">
    Carrito actualizado
  </div>
</div>

<script src="/js/cart.js"></script>